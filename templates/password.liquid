<div class="password-page">
  <div>
    <img src="{{ 'banishq-wordmark-bone.png' | asset_url }}" alt="{{ shop.name }}">
    <p class="eyebrow" style="color: var(--bq-stone)">{{ 'general.password_page.opening_soon' | t }}</p>
    <h1 class="h-serif h1" style="margin-bottom: 16px">{{ settings.brand_tagline }}</h1>
    <div class="rte" style="max-width: 46ch; margin: 0 auto 30px; color: rgba(244,241,235,0.72)">
      {{ shop.password_message | default: 'A modern Indian unisex label. Drop 01 lands soon.' }}
    </div>

    {%- form 'customer', class: 'newsletter__form', style: 'max-width: 380px; margin-inline: auto' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.email' | t }}</label>
      <input id="PasswordEmail" type="email" name="contact[email]" class="newsletter__input" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
      <button type="submit" class="newsletter__submit">{{ 'general.newsletter.submit' | t }}</button>
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <div style="margin-top: 40px">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form__message form__message--error" style="justify-content: center">{{ form.errors.translated_fields.form }} {{ form.errors.messages.form }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'general.password_page.password_label' | t }}</label>
        <div style="display: flex; gap: 8px; max-width: 380px; margin-inline: auto">
          <input id="StorePassword" type="password" name="password" class="field__input" placeholder="{{ 'general.password_page.password_label' | t }}" style="background: transparent; color: var(--bq-bone); border-color: rgba(244,241,235,0.3)">
          <button type="submit" class="button button--bone">{{ 'general.password_page.enter' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
