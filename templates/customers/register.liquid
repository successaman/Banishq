<div class="page-width section">
  <div class="auth-card">
    <h1 class="h-serif h1 text-center" style="margin-bottom: 24px">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="RegisterFirst">{{ 'customer.register.first_name' | t }}</label>
        <input class="field__input" id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLast">{{ 'customer.register.last_name' | t }}</label>
        <input class="field__input" id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
        <input class="field__input" id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
        <input class="field__input" id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
      <p class="text-center" style="margin-top: 16px; font-size: 0.85rem">
        <a href="{{ routes.account_login_url }}" style="text-decoration: underline">{{ 'customer.register.have_account' | t }}</a>
      </p>
    {%- endform -%}
  </div>
</div>
