{%- comment -%} Reads handles from localStorage and fetches each card. Hidden until filled. {%- endcomment -%}
<section class="section recent" data-recent data-limit="{{ section.settings.limit }}" hidden>
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ul class="product-grid" style="--grid-desktop: {{ section.settings.limit }}" role="list" data-recent-grid></ul>
  </div>
</section>
{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Picked up again" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where you left off" },
    { "type": "range", "id": "limit", "min": 2, "max": 5, "step": 1, "label": "Products shown", "default": 4 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
