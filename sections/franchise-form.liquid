{%- comment -%}
  Franchise enquiry. Posts through Shopify's contact form, so replies land in
  the store inbox with the enquiry tagged in the message body.
{%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="split" style="border: 1px solid var(--bq-line)">
      <div class="split__body" style="background: var(--bq-page)">
        <span class="seam-rule"></span>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="{% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte text-mute">{{ section.settings.text }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="icols" style="--icols: 1; margin-top: 26px; gap: 16px">
            {%- for block in section.blocks -%}
              <div class="icol" {{ block.shopify_attributes }}>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="split__body">
        {%- form 'contact', id: 'FranchiseForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success">{{ 'franchise.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[enquiry_type]" value="Franchise">

          <div class="formgrid formgrid--2">
            <div class="field">
              <label class="field__label" for="FranchiseName">{{ 'contact.form.name' | t }}</label>
              <input class="field__input" id="FranchiseName" type="text" name="contact[name]" autocomplete="name" required>
            </div>
            <div class="field">
              <label class="field__label" for="FranchisePhone">{{ 'franchise.phone' | t }}</label>
              <input class="field__input" id="FranchisePhone" type="tel" name="contact[phone]" autocomplete="tel" required>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="FranchiseEmail">{{ 'contact.form.email' | t }}</label>
            <input class="field__input" id="FranchiseEmail" type="email" name="contact[email]" autocomplete="email" required>
          </div>

          <div class="formgrid formgrid--2">
            <div class="field">
              <label class="field__label" for="FranchiseCity">{{ 'franchise.city' | t }}</label>
              <input class="field__input" id="FranchiseCity" type="text" name="contact[city]" required>
            </div>
            <div class="field">
              <label class="field__label" for="FranchiseBudget">{{ 'franchise.budget' | t }}</label>
              <div class="select">
                <select class="select__select" id="FranchiseBudget" name="contact[investment]">
                  {%- assign ranges = section.settings.investment_options | split: ',' -%}
                  {%- for range in ranges -%}
                    <option value="{{ range | strip | escape }}">{{ range | strip }}</option>
                  {%- endfor -%}
                </select>
                <span class="select__icon">{% render 'icon', name: 'chevron-down' %}</span>
              </div>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="FranchiseMessage">{{ 'franchise.message' | t }}</label>
            <textarea class="field__input" id="FranchiseMessage" name="contact[body]" placeholder="{{ 'franchise.message_placeholder' | t }}"></textarea>
          </div>

          <button type="submit" class="button button--full">{{ 'franchise.submit' | t }}</button>
          <p class="text-mute" style="font-size: 0.75rem; margin: 12px 0 0">{{ section.settings.note }}</p>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Franchise enquiry",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Partner with us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring BANISHQ to your city." },
    {
      "type": "richtext", "id": "text", "label": "Text",
      "default": "<p>We are opening franchise stores across India. If you have retail space in a high-street or mall location and want to run it properly, we would like to hear from you.</p>"
    },
    {
      "type": "text", "id": "investment_options", "label": "Investment ranges",
      "info": "Comma separated.",
      "default": "₹15L – ₹25L, ₹25L – ₹40L, ₹40L – ₹60L, ₹60L and above"
    },
    { "type": "text", "id": "note", "label": "Note", "default": "We reply to every serious enquiry within three working days." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "What we look for",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "600–1,200 sq ft" },
        { "type": "text", "id": "text", "label": "Text", "default": "Ground floor high street, or an anchor position in a Tier 1 or Tier 2 mall." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Franchise enquiry",
      "blocks": [
        { "type": "point", "settings": { "title": "600–1,200 sq ft", "text": "Ground floor high street, or an anchor position in a Tier 1 or Tier 2 mall." } },
        { "type": "point", "settings": { "title": "Retail experience helps", "text": "Not essential. Commitment to the floor matters more than a CV." } },
        { "type": "point", "settings": { "title": "We supply everything", "text": "Fit-out kit, stock, visual merchandising calendar and staff training." } }
      ]
    }
  ]
}
{% endschema %}
