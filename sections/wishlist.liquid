{%- comment -%}
  Wishlist page. Handles live in this browser only (localStorage) — the cards
  are fetched from the storefront so prices and availability stay current.
{%- endcomment -%}
<section class="section" data-wishlist-page>
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h1>
        <p class="section-head__sub">{{ section.settings.text }}</p>
      </div>
    </div>

    <ul class="product-grid" style="--grid-desktop: 4" role="list" data-wishlist-grid hidden></ul>

    <div class="wishlist-empty" data-wishlist-empty hidden>
      <h2 class="empty-state__title">{{ 'wishlist.empty' | t }}</h2>
      <p class="text-mute">{{ 'wishlist.empty_text' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button" style="margin-top: 18px">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Saved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your wishlist" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Saved on this device. Sign in and add to bag when you are ready." }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
