{%- comment -%}
  Shopify product recommendations. On first render the section has no
  `recommendations` object, so it fetches itself from the recommendations
  route and swaps in the result. Renders nothing when there is nothing to show.
{%- endcomment -%}
<section
  class="section"
  data-related-products
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.columns }}">
  <div class="page-width">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="section-head">
        <div class="section-head__text">
          <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
      <ul class="product-grid" style="--grid-desktop: {{ section.settings.columns }}" role="list">
        {%- for recommended in recommendations.products -%}
          <li>{% render 'product-card', card_product: recommended, index: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var host = document.currentScript.previousElementSibling;
    if (!host || host.querySelector('.product-grid')) return;
    fetch(host.dataset.url)
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-related-products] .page-width');
        var current = host.querySelector('.page-width');
        if (fresh && current) current.innerHTML = fresh.innerHTML;
      })
      .catch(function () {});
  })();
</script>

{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Completes the rotation" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Products shown", "default": 4 }
  ]
}
{% endschema %}
