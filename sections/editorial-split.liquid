{%- comment -%}
  Half image, half statement. The brand-story unit — used for the label story,
  the fabric story, or the franchise/store story.
{%- endcomment -%}
<section class="split split--{{ section.settings.scheme }}{% if section.settings.reverse %} split--reverse{% endif %}">
  <div class="split__media">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}"
           srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
           sizes="(min-width: 990px) 50vw, 100vw"
           alt="{{ section.settings.image.alt | escape }}" loading="lazy">
    {%- else -%}
      <img src="https://images.unsplash.com/photo-1594035795389-9363dd86b113?w=1400&q=80&auto=format&fit=crop"
           alt=""
           loading="lazy"
           style="width: 100%; height: 100%; object-fit: cover">
    {%- endif -%}
  </div>
  <div class="split__body">
    <span class="seam-rule"></span>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="{% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte body-lg">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div style="margin-top: 28px">
        <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="button {% if section.settings.scheme == 'light' %}button--outline{% else %}button--bone{% endif %}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    {
      "type": "select",
      "id": "scheme",
      "label": "Panel colour",
      "options": [
        { "value": "light", "label": "Warm bone / white" },
        { "value": "dark", "label": "Black" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium make. Honest price." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We manufacture what we sell. No middle layer, no marked-up story — just considered cuts, heavier fabric and a price that stays between ₹199 and ₹2,999.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial split" }]
}
{% endschema %}
