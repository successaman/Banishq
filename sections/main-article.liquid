<article class="page-width page-width--narrow section">
  {% render 'breadcrumbs' %}
  <p class="eyebrow">
    {{ article.published_at | date: format: 'date' }}
    {%- if article.author != blank %} &middot; {{ article.author }}{% endif -%}
  </p>
  <h1 class="h-serif h1" style="margin-bottom: 26px">{{ article.title }}</h1>

  {%- if article.image -%}
    <div class="media media--wide" style="margin-bottom: 34px">
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title | escape }}" width="1400" height="788">
    </div>
  {%- endif -%}

  <div class="rte body-lg">{{ article.content }}</div>

  {%- if blog.comments_enabled? -%}
    <section style="margin-top: 56px">
      <h2 class="h3">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>

      {%- for comment in article.comments -%}
        <div style="padding-block: 20px; border-bottom: 1px solid var(--bq-line-soft)">
          <p class="mono" style="color: var(--bq-ink-mute)">
            {{ comment.author }} &middot; {{ comment.created_at | date: format: 'date' }}
          </p>
          <div class="rte">{{ comment.content }}</div>
        </div>
      {%- endfor -%}

      {%- form 'new_comment', article -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success">{{ 'blogs.comments.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label>
          <input class="field__input" id="CommentAuthor" type="text" name="comment[author]" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentEmail">{{ 'blogs.comments.email' | t }}</label>
          <input class="field__input" id="CommentEmail" type="email" name="comment[email]" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentBody">{{ 'blogs.comments.message' | t }}</label>
          <textarea class="field__input" id="CommentBody" name="comment[body]" required></textarea>
        </div>
        <button type="submit" class="button">{{ 'blogs.comments.post' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
