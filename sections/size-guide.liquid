{%- comment -%}
  Unisex size system. One table per fit family, mono numerals per the type
  system. Body measurements in inches unless the note says otherwise.
{%- endcomment -%}

<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.note != blank -%}<p class="section-head__sub">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div style="margin-bottom: 40px" {{ block.shopify_attributes }}>
        <h3 class="h4" style="margin-bottom: 14px">{{ block.settings.title }}</h3>
        <div class="table-scroll">
          <table class="size-table">
            <thead>
              <tr>
                {%- assign headers = block.settings.headers | split: ',' -%}
                {%- for header in headers -%}<th>{{ header | strip }}</th>{%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- assign rows = block.settings.rows | split: '
' -%}
              {%- for row in rows -%}
                {%- assign trimmed = row | strip -%}
                {%- if trimmed != blank -%}
                  <tr>
                    {%- assign cells = trimmed | split: ',' -%}
                    {%- for cell in cells -%}<td>{{ cell | strip }}</td>{%- endfor -%}
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    {%- endfor -%}

    {%- if section.settings.how_to_measure != blank -%}
      <div class="rte text-mute" style="max-width: 62ch">{{ section.settings.how_to_measure }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One size system. Every body." },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Body measurements in inches. Between two sizes? Take the larger one for relaxed fits, the smaller one for regular."
    },
    {
      "type": "richtext",
      "id": "how_to_measure",
      "label": "How to measure",
      "default": "<p><strong>Chest:</strong> around the fullest part, arms down. <strong>Waist:</strong> at the natural crease, not the belt line. <strong>Inseam:</strong> from crotch seam to hem of a pair that already fits.</p>"
    }
  ],
  "blocks": [
    {
      "type": "table",
      "name": "Table",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tops — unisex" },
        { "type": "text", "id": "headers", "label": "Headers", "info": "Comma separated.", "default": "Size, Chest, Length, Shoulder, Sleeve" },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Rows",
          "info": "One row per line, cells separated by commas.",
          "default": "XS, 34-36, 26.5, 16.5, 7.5\nS, 36-38, 27.5, 17.5, 8\nM, 38-40, 28.5, 18.5, 8.5\nL, 40-42, 29.5, 19.5, 9\nXL, 42-44, 30.5, 20.5, 9.5\nXXL, 44-46, 31.5, 21.5, 10"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size guide",
      "blocks": [
        { "type": "table" },
        {
          "type": "table",
          "settings": {
            "title": "Bottoms — unisex",
            "headers": "Size, Waist, Hip, Inseam",
            "rows": "28, 28-29, 36, 29\n30, 30-31, 38, 29.5\n32, 32-33, 40, 30\n34, 34-35, 42, 30.5\n36, 36-37, 44, 31\n38, 38-39, 46, 31.5"
          }
        }
      ]
    }
  ]
}
{% endschema %}
