{%- comment -%}
  First-visit signup. Shows once per browser, honours Escape and a click on the
  scrim, and never blocks a returning shopper.
{%- endcomment -%}
{%- if section.settings.enabled -%}
  <div class="popup" data-popup data-delay="{{ section.settings.delay }}" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
    <div class="popup__card">
      <button type="button" class="popup__close" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>

      <div class="popup__media">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="popup__body">
        <span class="seam-rule"></span>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h-serif h3" style="margin-bottom: 10px">{{ section.settings.heading }}</h2>
        <p class="text-mute" style="margin-bottom: 20px">{{ section.settings.text }}</p>

        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="popup">
          <div class="field">
            <label class="visually-hidden" for="PopupEmail">{{ 'general.newsletter.email' | t }}</label>
            <input id="PopupEmail" class="field__input" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" autocomplete="email" required>
          </div>
          <button type="submit" class="button button--full">{{ section.settings.button_label }}</button>
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success" style="margin-top: 12px">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}

        <p class="text-mute" style="font-size: 0.74rem; margin: 12px 0 0">{{ section.settings.note }}</p>
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable", "default": false },
    { "type": "range", "id": "delay", "min": 2, "max": 20, "step": 1, "unit": "s", "label": "Show after", "default": 8 },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "First order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off, once." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the list for drop alerts and early access. We email twice a month, never more." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send my code" },
    { "type": "text", "id": "note", "label": "Note", "default": "One use per customer. Not valid with other offers." }
  ]
}
{% endschema %}
