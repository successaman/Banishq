{%- comment -%} Reusable banner for content pages. Falls back to the page title. {%- endcomment -%}
<section class="pagehero{% unless section.settings.image %} pagehero--light{% endunless %}">
  {%- if section.settings.image -%}
    <div class="pagehero__media">
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="100vw" alt="{{ section.settings.image.alt | escape }}" width="2000" height="600" fetchpriority="high">
    </div>
  {%- endif -%}
  <div class="pagehero__inner page-width{% if section.settings.align == 'center' %} pagehero__inner--center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" {% if section.settings.image %}style="color: rgba(244,241,235,0.7)"{% endif %}>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="pagehero__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="pagehero__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Page banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "textarea", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" }]
    }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}
