{%- comment -%} Journal rail. Pulls the newest articles from a chosen blog. {%- endcomment -%}
{%- assign target_blog = blogs[section.settings.blog] -%}
<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if target_blog.url -%}
        <a href="{{ target_blog.url }}" class="link-underline">{{ 'blogs.general.all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    <div class="journal">
      {%- if target_blog.articles.size > 0 -%}
        {%- for article in target_blog.articles limit: section.settings.limit -%}
          <a class="journal__item" href="{{ article.url }}">
            <div class="journal__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="journal__meta">{{ article.published_at | date: format: 'date' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</span>
            <h3 class="journal__title">{{ article.title }}</h3>
            {%- if section.settings.show_excerpt -%}
              <p class="journal__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="journal__item">
            <div class="journal__media">{{ 'blog-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <span class="journal__meta">{{ 'blogs.general.placeholder_meta' | t }}</span>
            <h3 class="journal__title">{{ 'blogs.general.placeholder_title' | t }}</h3>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Journal rail",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes on fit, fabric and wearing things out" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Articles shown", "default": 3 },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true }
  ],
  "presets": [{ "name": "Journal rail" }]
}
{% endschema %}
