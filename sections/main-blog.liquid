{%- paginate blog.articles by 12 -%}
<div class="page-width section">
  {% render 'breadcrumbs' %}
  <h1 class="h-serif h1" style="margin-bottom: 34px">{{ blog.title }}</h1>

  {%- if blog.articles.size > 0 -%}
    <div class="tiles" style="--tiles-desktop: 3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="tile media media--wide">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.title | escape }}" loading="lazy">
          {%- else -%}
            {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="tile__body">
            <span class="tile__meta">{{ article.published_at | date: format: 'date' }}</span>
            <span class="tile__title" style="text-transform: none; letter-spacing: 0">{{ article.title }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- else -%}
    <p class="text-mute">{{ 'blogs.general.empty' | t }}</p>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
