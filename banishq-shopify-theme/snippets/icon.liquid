{%- comment -%}
  Renders a line icon from the BANISHQ set.
  Usage: {% render 'icon', name: 'bag' %}
  Stroke-based, 1.25px weight — quiet, editorial, never decorative.
{%- endcomment -%}

{%- liquid
  assign stroke = '1.4'
  assign box = '0 0 24 24'
-%}

{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>

  {%- when 'bag' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16l-1.2 13.2a1 1 0 0 1-1 .8H6.2a1 1 0 0 1-1-.8Z"/><path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10"/></svg>

  {%- when 'account' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/></svg>

  {%- when 'heart' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20.2 4.9 13.4a4.4 4.4 0 0 1 6.2-6.2l.9.9.9-.9a4.4 4.4 0 0 1 6.2 6.2Z"/></svg>

  {%- when 'share' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="18" cy="6" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="18" r="2.6"/><path d="m8.3 10.7 7.4-3.4M8.3 13.3l7.4 3.4"/></svg>

  {%- when 'menu' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3.5 7h17M3.5 12h17M3.5 17h11"/></svg>

  {%- when 'close' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>

  {%- when 'plus' -%}
    <svg class="icon-plus" viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" width="15" height="15" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>

  {%- when 'minus' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" width="15" height="15" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>

  {%- when 'chevron-down' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true" focusable="false"><path d="m6 9.5 6 6 6-6"/></svg>

  {%- when 'chevron-right' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true" focusable="false"><path d="m9.5 6 6 6-6 6"/></svg>

  {%- when 'arrow-right' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>

  {%- when 'filter' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" width="15" height="15" aria-hidden="true" focusable="false"><path d="M3.5 6.5h17M6.5 12h11M10 17.5h4"/></svg>

  {%- when 'truck' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 10h4l3 3v3.5h-7z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>

  {%- when 'return' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4.5h-4.5"/></svg>

  {%- when 'shield' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 5 6v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6Z"/><path d="m9 12 2 2 4-4"/></svg>

  {%- when 'ruler' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9.5h18v5H3z"/><path d="M7 9.5v2.5M11 9.5v3.5M15 9.5v2.5M19 9.5v3.5"/></svg>

  {%- when 'tag' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 3H3v8l10 10 8-8Z"/><circle cx="7" cy="7" r="1.4"/></svg>

  {%- when 'store' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 10v10h16V10"/><path d="M3 4h18l1.2 4.2A3 3 0 0 1 19.3 12a3 3 0 0 1-3-2.4A3 3 0 0 1 13.3 12a3 3 0 0 1-3-2.4A3 3 0 0 1 7.3 12a3 3 0 0 1-2.9-3.8Z"/></svg>

  {%- when 'leaf' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 19.5C4 13 8 7.5 19.5 5c1 10.5-4.5 14.5-11 14"/><path d="M4.5 19.5 12 12"/></svg>

  {%- when 'star' -%}
    <svg viewBox="{{ box }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.7l5.9-.8Z"/></svg>

  {%- when 'instagram' -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"/></svg>

  {%- when 'facebook' -%}
    <svg viewBox="{{ box }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.5-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7v3h3.1v8z"/></svg>

  {%- when 'youtube' -%}
    <svg viewBox="{{ box }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21.5 8.2a2.5 2.5 0 0 0-1.8-1.8C18.1 6 12 6 12 6s-6.1 0-7.7.4A2.5 2.5 0 0 0 2.5 8.2 26 26 0 0 0 2.1 12a26 26 0 0 0 .4 3.8 2.5 2.5 0 0 0 1.8 1.8C5.9 18 12 18 12 18s6.1 0 7.7-.4a2.5 2.5 0 0 0 1.8-1.8 26 26 0 0 0 .4-3.8 26 26 0 0 0-.4-3.8ZM10.1 14.6V9.4l5 2.6Z"/></svg>

  {%- when 'pinterest' -%}
    <svg viewBox="{{ box }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.5a9.5 9.5 0 0 0-3.5 18.3c-.1-.8-.1-2 .1-2.8l1.1-4.7s-.3-.6-.3-1.4c0-1.3.8-2.3 1.7-2.3.8 0 1.2.6 1.2 1.3 0 .8-.5 2.1-.8 3.2-.2.9.5 1.7 1.4 1.7 1.7 0 3-1.8 3-4.4 0-2.3-1.6-3.9-4-3.9-2.7 0-4.3 2-4.3 4.1 0 .8.3 1.7.7 2.2.1.1.1.2.1.3l-.3 1c0 .2-.1.2-.3.1-1.2-.6-1.9-2.3-1.9-3.7 0-3 2.2-5.8 6.3-5.8 3.3 0 5.9 2.4 5.9 5.5 0 3.3-2.1 5.9-5 5.9-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.8-.8 1.9-1.2 2.6A9.5 9.5 0 1 0 12 2.5Z"/></svg>

  {%- when 'whatsapp' -%}
    <svg viewBox="{{ box }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.8A9.1 9.1 0 0 0 4.2 16.5L3 21.2l4.8-1.2A9.1 9.1 0 1 0 12 2.8Zm0 16.6a7.5 7.5 0 0 1-3.8-1l-.3-.2-2.8.7.7-2.8-.2-.3a7.5 7.5 0 1 1 6.4 3.6Zm4.2-5.6c-.2-.1-1.3-.7-1.5-.8s-.4-.1-.5.1-.6.8-.7 1-.3.2-.5.1a6.1 6.1 0 0 1-3-2.6c-.2-.4.2-.4.6-1.2a.4.4 0 0 0 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c2.2.9 2.2.6 2.6.5a2.6 2.6 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3Z"/></svg>

  {%- when 'linkedin' -%}
    <svg viewBox="{{ box }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.9 20.5H3.6V9.6h3.3ZM5.2 8.2a1.9 1.9 0 1 1 0-3.8 1.9 1.9 0 0 1 0 3.8Zm15.3 12.3h-3.3v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8v5.4H10V9.6h3.1v1.5h.1a3.5 3.5 0 0 1 3.1-1.7c3.3 0 3.9 2.2 3.9 5Z"/></svg>

  {%- else -%}
    <svg viewBox="{{ box }}" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/></svg>
{%- endcase -%}
