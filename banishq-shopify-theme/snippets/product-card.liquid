{%- comment -%}
  BANISHQ product card.

  Parameters:
    card_product  {Object}  product
    ratio         {String}  portrait | tall | square  (defaults to theme setting)
    show_sizes    {Boolean} override the theme setting
    lazy          {Boolean} lazy-load the image (default true)
    index         {Number}  position in the grid, used for eager-loading the first row

  Commerce density comes from The Souled Store (badges, strike price, % off,
  size chips, wishlist). Restraint comes from the BANISHQ brief: bone ground,
  black type, burgundy only where it carries meaning.
{%- endcomment -%}

{%- liquid
  assign ratio = ratio | default: settings.card_image_ratio
  assign show_sizes = show_sizes | default: settings.card_show_sizes, allow_false: true
  assign index = index | default: 99
  if index < 4
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
-%}

{%- if card_product == blank or card_product.empty? -%}
  <div class="card">
    <div class="card__media media media--{{ ratio }}">
      <img
        src="https://images.unsplash.com/photo-1599725728598-dc7ed109ff89?w=700&q=80&auto=format&fit=crop"
        alt=""
        loading="lazy"
        width="700" height="875"
        class="card__img">
    </div>
    <div class="card__body">
      <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="price"><span class="price__regular">₹1,299</span></div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign target = card_product.selected_or_first_available_variant
    assign on_sale = false
    assign percent_off = 0
    if target.compare_at_price > target.price
      assign on_sale = true
      assign diff = target.compare_at_price | minus: target.price | times: 100.0
      assign percent_off = diff | divided_by: target.compare_at_price | round
    endif

    assign is_new = false
    if card_product.tags contains 'new' or card_product.tags contains 'New'
      assign is_new = true
    endif

    assign size_option_index = nil
    for option in card_product.options_with_values
      assign downcased = option.name | downcase
      if downcased contains 'size'
        assign size_option_index = forloop.index0
      endif
    endfor

    assign fallback_index = card_product.id | modulo: 6
  -%}

  <div class="card" data-product-card>
    <div class="card__media media media--{{ ratio }}">
      <a href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
        {%- if card_product.featured_media -%}
          <img
            src="{{ card_product.featured_media | image_url: width: 700 }}"
            srcset="{{ card_product.featured_media | image_url: width: 360 }} 360w,
                    {{ card_product.featured_media | image_url: width: 540 }} 540w,
                    {{ card_product.featured_media | image_url: width: 700 }} 700w,
                    {{ card_product.featured_media | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 24vw, (min-width: 750px) 33vw, 48vw"
            alt="{{ card_product.featured_media.alt | escape }}"
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
            loading="{{ loading }}"
            class="card__img">
        {%- else -%}
          {%- case fallback_index -%}
            {%- when 0 -%}
              <img src="https://images.unsplash.com/photo-1599725728598-dc7ed109ff89?w=700&q=80&auto=format&fit=crop" alt="" loading="{{ loading }}" width="700" height="875" class="card__img">
            {%- when 1 -%}
              <img src="https://images.unsplash.com/photo-1613915617430-8ab0fd7c6baf?w=700&q=80&auto=format&fit=crop" alt="" loading="{{ loading }}" width="700" height="875" class="card__img">
            {%- when 2 -%}
              <img src="https://images.unsplash.com/photo-1654005018306-7066fc118281?w=700&q=80&auto=format&fit=crop" alt="" loading="{{ loading }}" width="700" height="875" class="card__img">
            {%- when 3 -%}
              <img src="https://images.unsplash.com/photo-1632149877166-f75d49000351?w=700&q=80&auto=format&fit=crop" alt="" loading="{{ loading }}" width="700" height="875" class="card__img">
            {%- when 4 -%}
              <img src="https://images.unsplash.com/photo-1608146226687-b39d090a8c20?w=700&q=80&auto=format&fit=crop" alt="" loading="{{ loading }}" width="700" height="875" class="card__img">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1594035795519-19274ae37f71?w=700&q=80&auto=format&fit=crop" alt="" loading="{{ loading }}" width="700" height="875" class="card__img">
          {%- endcase -%}
        {%- endif -%}

        {%- if settings.card_second_image and card_product.media[1] -%}
          <img
            src="{{ card_product.media[1] | image_url: width: 700 }}"
            srcset="{{ card_product.media[1] | image_url: width: 360 }} 360w,
                    {{ card_product.media[1] | image_url: width: 700 }} 700w"
            sizes="(min-width: 990px) 24vw, (min-width: 750px) 33vw, 48vw"
            alt=""
            loading="lazy"
            class="card__img card__img--alt">
        {%- endif -%}
      </a>

      <div class="card__badges">
        {%- unless card_product.available -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- else -%}
          {%- if on_sale and percent_off >= settings.card_sale_badge_min -%}
            <span class="badge badge--sale">{{ percent_off }}% {{ 'products.product.off' | t }}</span>
          {%- endif -%}
          {%- if is_new -%}
            <span class="badge badge--new">{{ 'products.product.just_in' | t }}</span>
          {%- endif -%}
        {%- endunless -%}
      </div>

      <button
        type="button"
        class="card__wish"
        data-wish="{{ card_product.handle }}"
        aria-label="{{ 'products.product.save_to_wishlist' | t }}">
        {% render 'icon', name: 'heart' %}
      </button>

    </div>

    <div class="card__body">
      {%- if settings.card_show_vendor and card_product.type != blank -%}
        <span class="card__kicker">{{ card_product.type }}</span>
      {%- endif -%}

      <h3 class="card__title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>

      {% render 'price', product: card_product, show_save: true %}

      {%- assign colour_option = nil -%}
      {%- for option in card_product.options_with_values -%}
        {%- assign downcased = option.name | downcase -%}
        {%- if downcased contains 'colour' or downcased contains 'color' -%}
          {%- assign colour_option = option -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if colour_option and colour_option.values.size > 1 -%}
        <div class="card__swatches" aria-label="{{ colour_option.values.size }} colours">
          {%- for value in colour_option.values limit: 5 -%}
            <span class="swatch" style="background: {{ value | downcase | split: ' ' | last }};" title="{{ value }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Every card carries a visible Add to bag. A single-variant product adds
        straight away; anything with sizes reveals its size row, because a
        garment cannot be added to a bag without one. Previously the sizes were
        a hover overlay, which meant no add-to-cart path at all on a phone.
      {%- endcomment -%}
      {%- if settings.card_quick_add -%}
        <div class="card__quick">
          {%- if card_product.available == false -%}
            <button type="button" class="button button--outline button--sm button--full" disabled>
              {{ 'products.product.sold_out' | t }}
            </button>

          {%- elsif card_product.variants.size == 1 -%}
            <form data-product-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
              <input type="hidden" name="id" value="{{ card_product.variants.first.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="button button--outline button--sm button--full">
                {{ 'products.product.add_to_cart' | t }}
              </button>
            </form>

          {%- else -%}
            <button
              type="button"
              class="button button--outline button--sm button--full"
              data-size-toggle
              aria-expanded="false"
              aria-controls="CardSizes-{{ card_product.id }}-{{ index }}">
              {{ 'products.product.add_to_cart' | t }}
            </button>

            <div class="card__sizerow" id="CardSizes-{{ card_product.id }}-{{ index }}" hidden>
              <span class="card__sizerow-label">{{ 'products.product.choose_variant' | t }}</span>
              <div class="card__sizerow-chips">
                {%- if size_option_index != nil -%}
                  {%- assign size_values = card_product.options_with_values[size_option_index].values -%}
                  {%- for value in size_values limit: 8 -%}
                    {%- liquid
                      assign found = nil
                      for variant in card_product.variants
                        if variant.options[size_option_index] == value and variant.available
                          assign found = variant
                          break
                        endif
                      endfor
                    -%}
                    {%- if found -%}
                      <button type="button" class="card__size" data-quick-variant="{{ found.id }}" aria-label="{{ 'products.product.add_size' | t: size: value }}">{{ value }}</button>
                    {%- else -%}
                      <span class="card__size" disabled aria-hidden="true">{{ value }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for variant in card_product.variants limit: 8 -%}
                    {%- if variant.available -%}
                      <button type="button" class="card__size" data-quick-variant="{{ variant.id }}">{{ variant.title }}</button>
                    {%- else -%}
                      <span class="card__size" disabled aria-hidden="true">{{ variant.title }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
