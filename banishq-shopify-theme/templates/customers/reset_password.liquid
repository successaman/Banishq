<div class="page-width section">
  <div class="auth-card">
    <h1 class="h-serif h1 text-center" style="margin-bottom: 24px">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input class="field__input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetConfirm">{{ 'customer.reset_password.confirm' | t }}</label>
        <input class="field__input" id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
