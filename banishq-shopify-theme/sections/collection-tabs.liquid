{%- comment -%}
  Tabbed product rails — the Souled Store pattern for routing men, women and
  unisex from one homepage block without three separate scroll stops.
{%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="section-head section-head--center">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div data-tabs>
      <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="tab"
            role="tab"
            id="Tab-{{ section.id }}-{{ forloop.index0 }}"
            aria-controls="Panel-{{ section.id }}-{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}>
            {{ block.settings.label | default: collections[block.settings.collection].title }}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <div
          class="tabpanel"
          role="tabpanel"
          id="Panel-{{ section.id }}-{{ forloop.index0 }}"
          aria-labelledby="Tab-{{ section.id }}-{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}>
          {%- if coll.products.size > 0 -%}
            <ul class="product-grid" style="--grid-desktop: {{ section.settings.columns }}" role="list">
              {%- for product in coll.products limit: section.settings.product_limit -%}
                <li>{% render 'product-card', card_product: product, index: forloop.index0 %}</li>
              {%- endfor -%}
            </ul>
            {%- if coll.url -%}
              <div class="text-center" style="margin-top: 30px">
                <a href="{{ coll.url }}" class="button button--outline">{{ 'sections.featured_collection.view_all' | t }}</a>
              </div>
            {%- endif -%}
          {%- else -%}
            <ul class="product-grid" style="--grid-desktop: {{ section.settings.columns }}" role="list">
              {%- for i in (1..section.settings.columns) -%}<li>{% render 'product-card' %}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tabbed rails",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One label, every wardrobe" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 12, "step": 2, "label": "Products per tab", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Men" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed rails",
      "blocks": [
        { "type": "tab", "settings": { "label": "Men" } },
        { "type": "tab", "settings": { "label": "Women" } },
        { "type": "tab", "settings": { "label": "Unisex" } }
      ]
    }
  ]
}
{% endschema %}
