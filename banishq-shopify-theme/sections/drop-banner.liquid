{%- comment -%} Campaign end-frame with an optional drop countdown. {%- endcomment -%}
<section class="drop">
  {%- if section.settings.image -%}
    <div class="drop__media">
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
    </div>
  {%- endif -%}
  <div class="drop__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" style="color: rgba(244,241,235,0.7)">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="drop__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="hero__text" style="margin-inline: auto">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.countdown_to != blank -%}
      <div class="drop__countdown" data-countdown="{{ section.settings.countdown_to }}">
        <div class="drop__unit"><span class="drop__num" data-cd-days>00</span><span class="drop__label">{{ 'sections.countdown.days' | t }}</span></div>
        <div class="drop__unit"><span class="drop__num" data-cd-hours>00</span><span class="drop__label">{{ 'sections.countdown.hours' | t }}</span></div>
        <div class="drop__unit"><span class="drop__num" data-cd-minutes>00</span><span class="drop__label">{{ 'sections.countdown.minutes' | t }}</span></div>
        <div class="drop__unit"><span class="drop__num" data-cd-seconds>00</span><span class="drop__label">{{ 'sections.countdown.seconds' | t }}</span></div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--bone">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Drop banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01 · SS26" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Everyday Edit" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Twelve pieces. One rotation. Made to be worn until they are yours." },
    { "type": "text", "id": "countdown_to", "label": "Countdown to", "info": "ISO date, e.g. 2026-10-15T18:00:00" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Drop 01" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Drop banner" }]
}
{% endschema %}
