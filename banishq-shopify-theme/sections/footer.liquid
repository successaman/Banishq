{%- comment -%}
  BANISHQ footer. Warm bone on black — the "Dark" colour application from the
  brief. Primary horizontal logo, brand line kept separate from the artwork.
{%- endcomment -%}

<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div>
        <div class="footer__logo">
          {%- if settings.logo_primary -%}
            <img src="{{ settings.logo_primary | image_url: width: 500 }}" alt="{{ shop.name }}" width="200" loading="lazy">
          {%- else -%}
            <img src="{{ 'banishq-wordmark-bone.png' | asset_url }}" alt="{{ shop.name }}" width="200" loading="lazy">
          {%- endif -%}
        </div>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if section.settings.about != blank -%}
          <p class="footer__about">{{ section.settings.about }}</p>
        {%- endif -%}
        {% render 'social-icons' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__col footer__col--collapsible" {{ block.shopify_attributes }}>
              <p class="footer__title" data-footer-toggle>
                {{ block.settings.heading }}
                <span class="footer__accordion-toggle">{% render 'icon', name: 'plus' %}</span>
              </p>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'newsletter' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <p class="footer__title">{{ block.settings.heading }}</p>
              <p class="footer__about" style="margin-bottom: 16px">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'newsletter__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.email' | t }}</label>
                <input
                  id="FooterEmail"
                  type="email"
                  name="contact[email]"
                  class="newsletter__input"
                  placeholder="{{ 'general.newsletter.placeholder' | t }}"
                  autocomplete="email"
                  required>
                <button type="submit" class="newsletter__submit" aria-label="{{ 'general.newsletter.submit' | t }}">
                  {% render 'icon', name: 'arrow-right' %}
                </button>
                {%- if form.errors -%}
                  <p class="form__message form__message--error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
                {%- elsif form.posted_successfully? -%}
                  <p class="form__message form__message--success">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}
              <p class="newsletter__note">{{ block.settings.note }}</p>
            </div>

          {%- when 'contact' -%}
            <div class="footer__col footer__col--collapsible" {{ block.shopify_attributes }}>
              <p class="footer__title" data-footer-toggle>
                {{ block.settings.heading }}
                <span class="footer__accordion-toggle">{% render 'icon', name: 'plus' %}</span>
              </p>
              <ul class="footer__list">
                {%- if block.settings.phone != blank -%}
                  <li><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></li>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li>{{ block.settings.hours }}</li>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <li>{{ block.settings.address }}</li>
                {%- endif -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</span>

      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.credit != blank -%}
        <span>{{ section.settings.credit }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Brand line", "default": "Wear Your Presence." },
    {
      "type": "textarea",
      "id": "about",
      "label": "About",
      "default": "A modern Indian unisex label. Designed in India, made to be worn on repeat — from ₹199 to ₹2,999."
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "credit", "label": "Credit line", "default": "India" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "text", "id": "email", "label": "Email", "default": "care@banishq.com" },
        { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Sat, 10am–7pm IST" },
        { "type": "textarea", "id": "address", "label": "Address" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "First to know" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Drop alerts, restocks and the occasional early access. No noise." },
        { "type": "text", "id": "note", "label": "Note", "default": "By subscribing you agree to our privacy policy." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "About" } },
      { "type": "contact" },
      { "type": "newsletter" }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
