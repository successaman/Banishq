{%- comment -%} A single statement, generous space around it. {%- endcomment -%}
<section class="section">
  <div class="page-width page-width--narrow text-center">
    <span class="seam-rule seam-rule--center"></span>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="{% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte body-lg text-mute">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div style="margin-top: 28px">
        <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="button button--outline">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clothing is the tool. Presence is the point." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>BANISHQ is built for people who want what they wear to amplify who they already are — not speak over them.</p>" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
