{%- comment -%} Icon and text columns. Carries policy and service pages. {%- endcomment -%}
<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head{% if section.settings.align == 'center' %} section-head--center{% endif %}">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<p class="section-head__sub">{{ section.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="icols" style="--icols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="icol" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link }}" class="link-underline" style="margin-top: 4px">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Text columns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How returns work" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 3 },
    {
      "type": "select", "id": "align", "label": "Heading alignment", "default": "left",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" }]
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "return",
          "options": [
            { "value": "none", "label": "None" }, { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" }, { "value": "shield", "label": "Secure" },
            { "value": "ruler", "label": "Fit" }, { "value": "tag", "label": "Price" },
            { "value": "leaf", "label": "Fabric" }, { "value": "store", "label": "Store" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Raise it within 7 days" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>From the day it is delivered, unworn and with tags on.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text columns",
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
