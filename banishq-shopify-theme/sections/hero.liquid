{%- comment -%}
  Editorial hero. Full-bleed image, directional-light photography, headline set
  in Instrument Serif, copy anchored bottom-left with generous negative space.
  Slides only rotate when more than one block is present.
{%- endcomment -%}

<section class="hero" data-hero data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="hero__slides">
    {%- for block in section.blocks -%}
      <div class="hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        <div class="hero__media">
          {%- if block.settings.image -%}
            <picture>
              {%- if block.settings.image_mobile -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                          {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                  sizes="100vw">
              {%- endif -%}
              <img
                src="{{ block.settings.image | image_url: width: 2200 }}"
                srcset="{{ block.settings.image | image_url: width: 750 }} 750w,
                        {{ block.settings.image | image_url: width: 1100 }} 1100w,
                        {{ block.settings.image | image_url: width: 1600 }} 1600w,
                        {{ block.settings.image | image_url: width: 2200 }} 2200w"
                sizes="100vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            </picture>
          {%- else -%}
            <img
              src="{% cycle 'hero_fallback': 'https://images.unsplash.com/photo-1619603364937-8d7af41ef206?w=2200&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1632149877166-f75d49000351?w=2200&q=80&auto=format&fit=crop' %}"
              alt=""
              width="2200" height="1238"
              style="width: 100%; height: 100%; object-fit: cover"
              {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {%- endif -%}
          {%- assign scrim = block.settings.overlay | divided_by: 100.0 -%}
          <div
            class="hero__scrim"
            style="background: linear-gradient(180deg, rgba(17,17,17,{{ scrim | times: 0.9 }}) 0%, rgba(17,17,17,{{ scrim | times: 0.3 }}) 45%, rgba(17,17,17,{{ scrim | times: 1.45 }}) 100%);"></div>
        </div>

        <div class="page-width">
          <div class="hero__content{% if section.settings.alignment == 'center' %} hero__content--center{% endif %}">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow" style="color: rgba(244,241,235,0.72)">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="hero__title">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hero__text">{{ block.settings.text }}</p>
            {%- endif -%}
            <div class="hero__buttons">
              {%- if block.settings.button_1_label != blank -%}
                <a href="{{ block.settings.button_1_link }}" class="button button--bone">{{ block.settings.button_1_label }}</a>
              {%- endif -%}
              {%- if block.settings.button_2_label != blank -%}
                <a href="{{ block.settings.button_2_link }}" class="button button--ghost">{{ block.settings.button_2_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" aria-label="{{ 'sections.slideshow.load_slide' | t: slide_number: forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "range", "id": "interval", "min": 4, "max": 12, "step": 1, "unit": "s", "label": "Change slide every", "default": 6 },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Bottom left (editorial)" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Directional light, negative space, confident crop. 2200px wide minimum." },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. A taller crop for phones — most of your traffic." },
        { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image darkening", "default": 50 },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01 · SS26" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Wear Your Presence." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Unisex essentials built for repeat wear. Premium make, honest pricing." },
        { "type": "text", "id": "button_1_label", "label": "Button 1", "default": "Shop the drop" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
        { "type": "text", "id": "button_2_label", "label": "Button 2", "default": "New in" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
