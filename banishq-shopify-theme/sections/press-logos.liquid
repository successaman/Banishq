{%- comment -%} Quiet credibility strip. Grayscale so it never competes with the marks. {%- endcomment -%}
<section class="section section--tight">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="eyebrow eyebrow--mute text-center">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="press">
      {%- for block in section.blocks -%}
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.name | escape }}" loading="lazy" {{ block.shopify_attributes }}>
        {%- else -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Press strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Publication",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Publication" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press strip",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
