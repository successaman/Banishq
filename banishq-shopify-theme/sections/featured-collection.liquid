{%- comment -%} Merchandising rail. Grid on desktop, snap-scroll on mobile. {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ collections[section.settings.collection].url }}" class="link-underline">
          {{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- assign products = collections[section.settings.collection].products -%}
    {%- if products.size > 0 -%}
      <ul class="product-grid{% if section.settings.mobile_scroll %} scroll-row{% endif %}" style="--grid-desktop: {{ section.settings.columns }}" role="list">
        {%- for product in products limit: section.settings.product_limit -%}
          <li>{% render 'product-card', card_product: product, index: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="product-grid" style="--grid-desktop: {{ section.settings.columns }}" role="list">
        {%- for i in (1..section.settings.columns) -%}
          <li>{% render 'product-card' %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your next rotation just arrived." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 24, "step": 2, "label": "Products shown", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Swipe row on mobile", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
