{%- comment -%} Merchandising rail. Grid on desktop, snap-scroll on mobile. {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="link-underline">
          {{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- assign products = section.settings.collection.products -%}
    {%- assign is_rail = section.settings.mobile_scroll -%}
    {%- if products.size > 0 -%}
      <div class="rail{% if is_rail %} rail--carousel{% endif %}"{% if is_rail %} data-rail{% endif %}>
        <ul class="product-grid{% if is_rail %} scroll-row{% endif %}"
            style="--grid-desktop: {{ section.settings.columns }}"
            role="list"
            {% if is_rail %}data-rail-track{% endif %}>
          {%- for product in products limit: section.settings.product_limit -%}
            <li>{% render 'product-card', card_product: product, index: forloop.index0 %}</li>
          {%- endfor -%}
        </ul>

        {%- if is_rail -%}
          <button type="button" class="rail__nav rail__nav--prev" data-rail-prev aria-label="{{ 'sections.rail.previous' | t }}">
            {% render 'icon', name: 'chevron-right' %}
          </button>
          <button type="button" class="rail__nav rail__nav--next" data-rail-next aria-label="{{ 'sections.rail.next' | t }}">
            {% render 'icon', name: 'chevron-right' %}
          </button>
        {%- endif -%}
      </div>
    {%- else -%}
      <ul class="product-grid" style="--grid-desktop: {{ section.settings.columns }}" role="list">
        {%- for i in (1..section.settings.columns) -%}
          <li>{% render 'product-card' %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your next rotation just arrived." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 24, "step": 2, "label": "Products shown", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Show as swipe carousel", "info": "One row that scrolls sideways, with arrows on desktop. Off shows a wrapping grid.", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
