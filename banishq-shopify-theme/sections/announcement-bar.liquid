{%- comment -%}
  Utility strip. Voice rule: campaign statements, never desperation.
  "Not staying around forever." rather than "Shop now before stocks run out."
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement" data-announcement data-speed="{{ section.settings.rotate_speed | times: 1000 }}">
    <div class="page-width">
      <div class="announcement__inner">
        {%- if section.settings.left_text != blank -%}
          <div class="announcement__utils"><span>{{ section.settings.left_text }}</span></div>
        {%- endif -%}

        <div class="announcement__marquee">
          {%- for block in section.blocks -%}
            <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="announcement__utils">
          {%- if section.settings.right_link_1_text != blank -%}
            <a href="{{ section.settings.right_link_1 }}">{{ section.settings.right_link_1_text }}</a>
          {%- endif -%}
          {%- if section.settings.right_link_2_text != blank -%}
            <a href="{{ section.settings.right_link_2 }}">{{ section.settings.right_link_2_text }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "range", "id": "rotate_speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Rotate every", "default": 5 },
    { "type": "text", "id": "left_text", "label": "Left text", "default": "Free shipping over ₹999" },
    { "type": "text", "id": "right_link_1_text", "label": "Right link 1 text", "default": "Track order" },
    { "type": "url", "id": "right_link_1", "label": "Right link 1" },
    { "type": "text", "id": "right_link_2_text", "label": "Right link 2 text", "default": "Store locator" },
    { "type": "url", "id": "right_link_2", "label": "Right link 2" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Drop 01 is live. Not staying around forever." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Drop 01 is live. Not staying around forever." } },
      { "type": "message", "settings": { "text": "Everyday essentials from ₹199" } },
      { "type": "message", "settings": { "text": "Easy 7-day returns · COD available across India" } }
    ]
  },
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
