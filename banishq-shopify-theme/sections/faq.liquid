<section class="section">
  <div class="page-width page-width--narrow">
    <div class="section-head section-head--center">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
      </div>
    </div>

    {%- for block in section.blocks -%}
      <details class="accordion" {{ block.shopify_attributes }}>
        <summary class="accordion__summary" style="text-transform: none; letter-spacing: 0; font-size: 1rem">
          {{ block.settings.question }} {% render 'icon', name: 'plus' %}
        </summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered plainly" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are the fits truly unisex?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. One size system across the range, cut to sit well on every body. The size guide lists body measurements, not garment measurements.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item" },
        {
          "type": "item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Metro cities in 2 to 4 days, rest of India in 4 to 7. A tracking link reaches you the moment it ships.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Can I exchange for a different size?",
            "answer": "<p>Within 7 days of delivery, unworn and with tags on. One size exchange per order is free.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you take cash on delivery?",
            "answer": "<p>Yes, across serviceable pin codes in India.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
