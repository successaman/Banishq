{%- comment -%}
  Customer testimonials and reviews carousel, category-specific edition.
  Displays ratings, customer names, location, and review text.
{%- endcomment -%}

<section class="category-testimonials" style="padding-block: clamp(50px, 7vw, 100px)">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow text-center">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <div class="section-head section-head--center" style="margin-bottom: 40px">
      <div class="section-head__text">
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">
          {{ section.settings.heading }}
        </h2>
      </div>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__header">
            <div class="testimonial-card__rating">
              {%- for i in (1..5) -%}
                <span class="star{% if i <= block.settings.rating %} is-filled{% endif %}">★</span>
              {%- endfor -%}
            </div>
            <p class="testimonial-card__rating-text">{{ block.settings.rating }} out of 5 stars</p>
          </div>

          <p class="testimonial-card__text">{{ block.settings.text }}</p>

          <div class="testimonial-card__footer">
            <div class="testimonial-card__author">
              <p class="testimonial-card__name">{{ block.settings.author }}</p>
              <p class="testimonial-card__location">{{ block.settings.location }}</p>
            </div>

            {%- if block.settings.verified -%}
              <span class="testimonial-card__badge">Verified</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta -%}
      <div style="text-align: center; margin-top: 40px">
        <p style="color: var(--bq-ink-soft); font-size: 0.95rem; margin-bottom: 16px">
          {{ section.settings.cta_text }}
        </p>
        {%- if section.settings.cta_button_label != blank -%}
          <a href="{{ section.settings.cta_button_link }}" class="button button--ghost">
            {{ section.settings.cta_button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 24px;
  margin-bottom: 0;
}

@media (min-width: 750px) {
  .testimonials-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
}

.testimonial-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 28px;
  border: 1px solid var(--bq-line);
  border-radius: var(--bq-radius);
  background: var(--bq-page);
  transition: all 0.3s var(--bq-ease);
}

.testimonial-card:hover {
  border-color: var(--bq-burgundy);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}

.testimonial-card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.testimonial-card__rating {
  display: flex;
  gap: 4px;
  font-size: 1.2rem;
  line-height: 1;
}

.star {
  color: #ddd;
  transition: color 0.2s;
}

.star.is-filled {
  color: var(--bq-burgundy);
}

.testimonial-card__rating-text {
  font-size: 0.75rem;
  color: var(--bq-ink-soft);
  margin: 0;
  text-align: right;
  line-height: 1.3;
}

.testimonial-card__text {
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 0;
  color: var(--bq-ink);
}

.testimonial-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
  margin-top: 8px;
  padding-top: 16px;
  border-top: 1px solid var(--bq-line);
}

.testimonial-card__author {
  flex: 1;
}

.testimonial-card__name {
  font-size: 0.9rem;
  font-weight: 600;
  margin: 0;
  color: var(--bq-ink);
}

.testimonial-card__location {
  font-size: 0.8rem;
  color: var(--bq-ink-soft);
  margin: 4px 0 0;
}

.testimonial-card__badge {
  display: inline-block;
  padding: 4px 8px;
  background: var(--bq-burgundy);
  color: var(--bq-bone);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-family: var(--bq-font-mono);
  border-radius: var(--bq-radius-sm);
}

@media (max-width: 749px) {
  .testimonials-grid {
    grid-template-columns: 1fr;
  }

  .testimonial-card {
    padding: 20px;
  }
}
</style>

{% schema %}
{
  "name": "Category testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real feedback" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Share your story and earn rewards for reviews" },
    { "type": "text", "id": "cta_button_label", "label": "CTA button label", "default": "Write a review" },
    { "type": "url", "id": "cta_button_link", "label": "CTA button link" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "limit": 6,
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Great quality and fit. I've ordered multiple times." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Aditya S." },
        { "type": "text", "id": "location", "label": "City", "default": "Bangalore" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "rating": 5, "text": "The fit is exactly as described. Perfect for work and casual wear.", "author": "Priya M.", "location": "Mumbai", "verified": true } },
        { "type": "testimonial", "settings": { "rating": 5, "text": "Better quality than expected at this price point. Highly recommend.", "author": "Rohit K.", "location": "Delhi", "verified": true } },
        { "type": "testimonial", "settings": { "rating": 5, "text": "Sizing is true to size. Comfortable for all-day wear.", "author": "Shruti D.", "location": "Pune", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
