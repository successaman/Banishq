{%- comment -%} Search results. {%- endcomment -%}
{%- paginate search.results by 24 -%}
<div class="page-width section">
  <h1 class="h-serif h1" style="margin-bottom: 10px">
    {%- if search.performed -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'general.search.title' | t }}{%- endif -%}
  </h1>
  {%- if search.performed -%}
    <p class="collection-toolbar__count" style="margin-bottom: 30px">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
  {%- endif -%}

  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 560px; margin-bottom: 44px">
    <div class="field" style="display: flex; gap: 10px; margin: 0">
      <label class="visually-hidden" for="SearchPageInput">{{ 'general.search.placeholder' | t }}</label>
      <input id="SearchPageInput" class="field__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </div>
  </form>

  {%- if search.performed and search.results.size > 0 -%}
    <ul class="product-grid" style="--grid-desktop: 4" role="list">
      {%- for item in search.results -%}
        <li>
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', card_product: item, index: forloop.index0 %}
          {%- else -%}
            <a href="{{ item.url }}">
              <div class="media media--tall">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 600 }}" alt="{{ item.title | escape }}" loading="lazy">{%- endif -%}
              </div>
              <h3 class="card__title" style="margin-top: 12px">{{ item.title }}</h3>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- elsif search.performed -%}
    <div class="empty-state">
      <h2 class="empty-state__title">{{ 'general.search.no_results_title' | t }}</h2>
      <p class="text-mute">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button" style="margin-top: 20px">{{ 'general.search.browse_all' | t }}</a>
    </div>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Search results" }
{% endschema %}
