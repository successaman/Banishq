{%- comment -%}
  Category domain tabs — two large square buttons for Men/Women and Unisex,
  each linking to a different subdomain or collection. Opens in current window
  or new tab based on settings.
{%- endcomment -%}

<section class="category-tabs" style="padding-block: clamp(50px, 7vw, 100px)">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow text-center">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    
    <div class="section-head section-head--center" style="margin-bottom: 40px">
      <div class="section-head__text">
        <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="section-head__sub">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="tabs-grid">
      {%- for block in section.blocks -%}
        <a 
          href="{{ block.settings.link }}"
          class="tab-card"
          {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
          {{ block.shopify_attributes }}>
          
          <div class="tab-card__media">
            {%- if block.settings.image -%}
              <img 
                src="{{ block.settings.image | image_url: width: 1000 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="500" height="500">
            {%- else -%}
              <div class="placeholder-image">{{ 'collection-2' | placeholder_svg_tag }}</div>
            {%- endif -%}
            
            {%- if block.settings.badge != blank -%}
              <span class="tab-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>

          <div class="tab-card__body">
            <h3 class="tab-card__title">{{ block.settings.title }}</h3>
            
            {%- if block.settings.description != blank -%}
              <p class="tab-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
            
            <div class="tab-card__arrow">
              {% render 'icon', name: 'arrow-right' %}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.tabs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 24px;
  margin-top: 40px;
}

@media (min-width: 750px) {
  .tabs-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 34px;
    max-width: 900px;
    margin: 40px auto 0;
  }
}

.tab-card {
  position: relative;
  display: grid;
  grid-template-rows: auto auto;
  gap: 20px;
  padding: 0;
  text-decoration: none;
  color: inherit;
  border: 1px solid var(--bq-line);
  overflow: hidden;
  transition: all 0.3s var(--bq-ease);
}

.tab-card:hover {
  border-color: var(--bq-burgundy);
  box-shadow: 0 8px 24px rgba(123, 35, 48, 0.12);
}

.tab-card:active {
  transform: scale(0.98);
}

.tab-card__media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--bq-page);
}

.tab-card__media img,
.placeholder-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: scale 0.4s var(--bq-ease);
}

.tab-card:hover .tab-card__media img,
.tab-card:hover .placeholder-image {
  scale: 1.04;
}

.placeholder-image {
  display: grid;
  place-items: center;
  background: #ece8e0;
}

.tab-card__badge {
  position: absolute;
  top: 16px;
  right: 16px;
  padding: 6px 14px;
  background: var(--bq-burgundy);
  color: var(--bq-bone);
  font-family: var(--bq-font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
}

.tab-card__body {
  display: grid;
  gap: 8px;
  padding: 20px;
  align-content: start;
}

.tab-card__title {
  font-family: var(--bq-font-display);
  font-size: 1.8rem;
  font-weight: 400;
  margin: 0;
  line-height: 1.1;
}

.tab-card__description {
  font-size: 0.88rem;
  color: var(--bq-ink-soft);
  margin: 8px 0 0;
}

.tab-card__arrow {
  display: flex;
  align-items: center;
  margin-top: 12px;
  width: fit-content;
  font-weight: 600;
  color: var(--bq-burgundy);
  transition: translate 0.3s var(--bq-ease);
}

.tab-card__arrow svg {
  width: 16px;
  height: 16px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.5;
  margin-left: 8px;
}

.tab-card:hover .tab-card__arrow {
  translate: 4px 0;
}
</style>

{% schema %}
{
  "name": "Category tabs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your path" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Select a category to explore our curated collections" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Square image (1:1 recommended)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Men's" },
        { "type": "text", "id": "description", "label": "Description", "default": "Curated for the modern man" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Link (subdomain or collection)" },
        { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tabs",
      "blocks": [
        { "type": "category", "settings": { "title": "Men's & Women's", "description": "Shop our full collections", "link": "/" } },
        { "type": "category", "settings": { "title": "Unisex", "description": "Gender-neutral styles", "link": "/" } }
      ]
    }
  ]
}
{% endschema %}
