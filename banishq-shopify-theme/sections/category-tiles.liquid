{%- comment -%}
  Shop-by tiles. Taneira uses these to route a broad catalogue calmly;
  The Souled Store uses them for speed. Both, in bone and black.
{%- endcomment -%}
<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link | default: routes.collections_url }}" class="link-underline">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.layout == 'circles' -%}
      <div class="quicklinks">
        {%- for block in section.blocks -%}
          {%- assign coll = block.settings.collection -%}
          <a href="{{ block.settings.link | default: coll.url }}" class="quicklink" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 260 }}" alt="{{ block.settings.title | escape }}" width="92" height="92" loading="lazy">
            {%- elsif coll.featured_image -%}
              <img src="{{ coll.featured_image | image_url: width: 260 }}" alt="{{ coll.title | escape }}" width="92" height="92" loading="lazy">
            {%- else -%}
              <img
                src="{% cycle 'quicklink_fallback': 'https://images.unsplash.com/photo-1599725728598-dc7ed109ff89?w=260&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1613915617430-8ab0fd7c6baf?w=260&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1654005018306-7066fc118281?w=260&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1632149877166-f75d49000351?w=260&q=80&auto=format&fit=crop' %}"
                alt="{{ block.settings.title | escape }}" width="92" height="92" loading="lazy">
            {%- endif -%}
            <span class="quicklink__label">{{ block.settings.title | default: coll.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="tiles" style="--tiles-desktop: {{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          {%- assign coll = block.settings.collection -%}
          <a href="{{ block.settings.link | default: coll.url }}" class="tile media media--{{ section.settings.ratio }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}"
                   srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                   sizes="(min-width: 750px) 25vw, 50vw"
                   alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- elsif coll.featured_image -%}
              <img src="{{ coll.featured_image | image_url: width: 900 }}" alt="{{ coll.title | escape }}" loading="lazy">
            {%- else -%}
              <img
                src="{% cycle 'tile_fallback': 'https://images.unsplash.com/photo-1599725728598-dc7ed109ff89?w=900&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1613915617430-8ab0fd7c6baf?w=900&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1654005018306-7066fc118281?w=900&q=80&auto=format&fit=crop', 'https://images.unsplash.com/photo-1632149877166-f75d49000351?w=900&q=80&auto=format&fit=crop' %}"
                alt="{{ block.settings.title | escape }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover">
            {%- endif -%}
            <span class="tile__body">
              <span class="tile__title">{{ block.settings.title | default: coll.title }}</span>
              {%- if block.settings.meta != blank -%}<span class="tile__meta">{{ block.settings.meta }}</span>{%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start where you live" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "tiles", "label": "Image tiles" },
        { "value": "circles", "label": "Circular quick links" }
      ],
      "default": "tiles"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile ratio",
      "options": [
        { "value": "tall", "label": "4:5" },
        { "value": "portrait", "label": "3:4" },
        { "value": "square", "label": "1:1" }
      ],
      "default": "portrait"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "meta", "label": "Meta line", "default": "From ₹499" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Tees", "meta": "From ₹199" } },
        { "type": "tile", "settings": { "title": "Shirts & Overshirts", "meta": "From ₹899" } },
        { "type": "tile", "settings": { "title": "Cargos & Trousers", "meta": "From ₹999" } },
        { "type": "tile", "settings": { "title": "Co-ords", "meta": "From ₹1,499" } }
      ]
    }
  ]
}
{% endschema %}
