{%- comment -%} Campaign grid. One wide anchor image, three supporting crops. {%- endcomment -%}
<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="section-head__title {% if settings.heading_style == 'serif' %}h-serif{% endif %} h2">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link }}" class="link-underline">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="lookbook">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="lookbook__item{% if block.settings.wide %} lookbook__item--wide{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.label | escape }}" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}<span class="lookbook__tag">{{ block.settings.label }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Campaign" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Presence, in practice" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the lookbook" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Tag", "default": "Shop the look" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "wide", "label": "Double width", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "image", "settings": { "wide": true, "label": "Drop 01" } },
        { "type": "image", "settings": { "label": "Overshirts" } },
        { "type": "image", "settings": { "label": "Cargos" } },
        { "type": "image", "settings": { "label": "Co-ords" } },
        { "type": "image", "settings": { "label": "Tees" } }
      ]
    }
  ]
}
{% endschema %}
