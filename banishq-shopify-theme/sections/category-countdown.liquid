{%- comment -%}
  Drop countdown timer for category-specific campaigns.
  Shows days, hours, minutes, seconds until a target date.
{%- endcomment -%}

<section class="category-countdown" data-countdown>
  <div class="page-width">
    <div class="countdown-card">
      <div class="countdown-card__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="countdown-card__title">{{ section.settings.heading }}</h2>

        {%- if section.settings.text != blank -%}
          <p class="countdown-card__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.settings.target_date != blank -%}
        <div class="countdown-timer" data-countdown-timer data-target-date="{{ section.settings.target_date | date: '%Y-%m-%dT%H:%M:%SZ' }}">
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="days">00</div>
            <div class="countdown-label">{{ 'sections.countdown.days' | t }}</div>
          </div>
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="hours">00</div>
            <div class="countdown-label">{{ 'sections.countdown.hours' | t }}</div>
          </div>
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="minutes">00</div>
            <div class="countdown-label">{{ 'sections.countdown.minutes' | t }}</div>
          </div>
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="seconds">00</div>
            <div class="countdown-label">{{ 'sections.countdown.seconds' | t }}</div>
          </div>
        </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="button button--primary" style="margin-top: 28px">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="countdown-card__media">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 600 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="500" height="600">
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1654005018306-7066fc118281?w=600&q=80&auto=format&fit=crop"
            alt=""
            loading="lazy"
            width="500" height="600">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
.category-countdown {
  padding: clamp(40px, 7vw, 100px) 0;
  background: var(--bq-page);
}

.countdown-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(30px, 5vw, 60px);
  align-items: center;
}

.countdown-card__content {
  padding: clamp(20px, 5vw, 40px);
}

.countdown-card__title {
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  font-family: var(--bq-font-display);
  margin: 16px 0;
  font-weight: 400;
  line-height: 1.2;
}

.countdown-card__text {
  font-size: 1rem;
  color: var(--bq-ink-soft);
  margin-top: 16px;
  max-width: 500px;
}

.countdown-timer {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin: 32px 0;
}

.countdown-unit {
  text-align: center;
  padding: 16px;
  background: var(--bq-bone);
  border: 1px solid var(--bq-line);
  border-radius: var(--bq-radius);
}

.countdown-value {
  font-family: var(--bq-font-mono);
  font-size: clamp(1.8rem, 5vw, 2.4rem);
  font-weight: 600;
  color: var(--bq-burgundy);
  line-height: 1;
  margin-bottom: 8px;
}

.countdown-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
  color: var(--bq-ink);
}

.countdown-card__media {
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: var(--bq-radius-lg);
}

.countdown-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media (max-width: 749px) {
  .countdown-card {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .countdown-card__media {
    aspect-ratio: 16 / 9;
    order: -1;
  }

  .countdown-timer {
    gap: 12px;
  }

  .countdown-unit {
    padding: 12px 8px;
  }

  .countdown-value {
    font-size: 1.6rem;
  }
}
</style>

<script>
(function () {
  // This was written as a <countdown-timer> custom element while the markup is
  // a div, so it never upgraded and the clock sat at 00:00:00:00. Plain
  // initialiser now, keyed off the data attribute.
  function tick(el) {
    var target = new Date(el.dataset.targetDate).getTime();
    if (isNaN(target)) { el.hidden = true; return false; }

    var distance = target - Date.now();
    if (distance <= 0) {
      // Nothing useful to say once it has passed; hide rather than show zeros.
      el.hidden = true;
      el.setAttribute('data-expired', '');
      return false;
    }

    var d = Math.floor(distance / 86400000);
    var h = Math.floor((distance % 86400000) / 3600000);
    var m = Math.floor((distance % 3600000) / 60000);
    var sec = Math.floor((distance % 60000) / 1000);
    var set = function (unit, v) {
      var node = el.querySelector('[data-unit="' + unit + '"]');
      if (node) node.textContent = String(v).padStart(2, '0');
    };
    set('days', d); set('hours', h); set('minutes', m); set('seconds', sec);
    return true;
  }

  function init(root) {
    var timers = (root || document).querySelectorAll('[data-countdown-timer]');
    Array.prototype.forEach.call(timers, function (el) {
      if (el.dataset.countdownReady) return;
      el.dataset.countdownReady = '1';
      if (!tick(el)) return;
      var id = setInterval(function () {
        if (!tick(el)) clearInterval(id);
      }, 1000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(); });
  } else {
    init();
  }
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
</script>

{% schema %}
{
  "name": "Category countdown",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drop launches in" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Mark your calendar. Set your alarm. The new collection drops soon." },
    { "type": "text", "id": "target_date", "label": "Countdown end date", "info": "Format: 2026-10-15 18:00. Leave blank to hide the clock — Shopify has no date picker for theme settings." },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    {
      "name": "Category countdown"
    }
  ]
}
{% endschema %}
