{%- comment -%}
  Drop countdown timer for category-specific campaigns.
  Shows days, hours, minutes, seconds until a target date.
{%- endcomment -%}

<section class="category-countdown" data-countdown>
  <div class="page-width">
    <div class="countdown-card">
      <div class="countdown-card__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="countdown-card__title">{{ section.settings.heading }}</h2>

        {%- if section.settings.text != blank -%}
          <p class="countdown-card__text">{{ section.settings.text }}</p>
        {%- endif -%}

        <div class="countdown-timer" data-target-date="{{ section.settings.target_date | date: '%Y-%m-%dT%H:%M:%SZ' }}">
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="days">00</div>
            <div class="countdown-label">{{ 'sections.countdown.days' | t }}</div>
          </div>
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="hours">00</div>
            <div class="countdown-label">{{ 'sections.countdown.hours' | t }}</div>
          </div>
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="minutes">00</div>
            <div class="countdown-label">{{ 'sections.countdown.minutes' | t }}</div>
          </div>
          <div class="countdown-unit">
            <div class="countdown-value" data-unit="seconds">00</div>
            <div class="countdown-label">{{ 'sections.countdown.seconds' | t }}</div>
          </div>
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary" style="margin-top: 28px">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.image -%}
        <div class="countdown-card__media">
          <img
            src="{{ section.settings.image | image_url: width: 600 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="500" height="600">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.category-countdown {
  padding: clamp(40px, 7vw, 100px) 0;
  background: var(--bq-page);
}

.countdown-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(30px, 5vw, 60px);
  align-items: center;
}

.countdown-card__content {
  padding: clamp(20px, 5vw, 40px);
}

.countdown-card__title {
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  font-family: var(--bq-font-display);
  margin: 16px 0;
  font-weight: 400;
  line-height: 1.2;
}

.countdown-card__text {
  font-size: 1rem;
  color: var(--bq-ink-soft);
  margin-top: 16px;
  max-width: 500px;
}

.countdown-timer {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin: 32px 0;
}

.countdown-unit {
  text-align: center;
  padding: 16px;
  background: var(--bq-bone);
  border: 1px solid var(--bq-line);
}

.countdown-value {
  font-family: var(--bq-font-mono);
  font-size: clamp(1.8rem, 5vw, 2.4rem);
  font-weight: 600;
  color: var(--bq-burgundy);
  line-height: 1;
  margin-bottom: 8px;
}

.countdown-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
  color: var(--bq-ink);
}

.countdown-card__media {
  aspect-ratio: 4 / 5;
  overflow: hidden;
}

.countdown-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media (max-width: 749px) {
  .countdown-card {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .countdown-card__media {
    aspect-ratio: 16 / 9;
    order: -1;
  }

  .countdown-timer {
    gap: 12px;
  }

  .countdown-unit {
    padding: 12px 8px;
  }

  .countdown-value {
    font-size: 1.6rem;
  }
}
</style>

<script>
if (!customElements.get('countdown-timer')) {
  customElements.define('countdown-timer', class extends HTMLElement {
    connectedCallback() {
      this.update();
      setInterval(() => this.update(), 1000);
    }

    update() {
      const targetDate = new Date(this.dataset.targetDate).getTime();
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance < 0) {
        this.setAttribute('data-expired', '');
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      this.querySelector('[data-unit="days"]').textContent = String(days).padStart(2, '0');
      this.querySelector('[data-unit="hours"]').textContent = String(hours).padStart(2, '0');
      this.querySelector('[data-unit="minutes"]').textContent = String(minutes).padStart(2, '0');
      this.querySelector('[data-unit="seconds"]').textContent = String(seconds).padStart(2, '0');
    }
  });
}
</script>

{% schema %}
{
  "name": "Category countdown",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drop launches in" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Mark your calendar. Set your alarm. The new collection drops soon." },
    { "type": "datetime", "id": "target_date", "label": "Countdown end date" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    {
      "name": "Category countdown"
    }
  ]
}
{% endschema %}
